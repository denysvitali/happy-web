{
  "name": "happy-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate": "buf generate",
    "vectors": "sh scripts/gen-crypto-vectors.sh",
    "size": "size-limit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "3.7.0",
    "tweetnacl": "1.0.3",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "size-limit": "14.3.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@bufbuild/buf"
    ]
  },
  "size-limit": [
    {
      "name": "initial JS (entry chunk)",
      "path": "dist/assets/index-*.js",
      "limit": "250 KB",
      "gzip": true
    }
  ]
}
